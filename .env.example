# Copy to .env.local and fill in. .env.local is git-ignored.
# The same names are set as GitHub repository secrets for the deploy workflow.

# Supabase: Project Settings > API (Project URL, and the anon / publishable key)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Cloud "PRABAS" project: OAuth client ID (Web application). Public identifier, not a secret.
VITE_GOOGLE_CLIENT_ID=
